# Copy to .env.local and fill in real values. All EXPO_PUBLIC_* vars are
# bundled into the client — never put secrets there. True secrets (API keys,
# client secrets) belong only in the server route handlers under
# src/app/api/**/+api.ts, read via process.env without the EXPO_PUBLIC_ prefix.

# --- Strava (OAuth) ---
# Public client id is safe to ship; the secret stays server-side and is used
# only inside src/app/api/strava/token+api.ts during the code exchange.
EXPO_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Anthropic / Claude (AI coach chat, meal + progress photo analysis) ---
# Server-side only — used by src/app/api/claude/**/+api.ts. Never prefix
# this with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-5-5. claude-sonnet-5-5 costs about half.
CLAUDE_MODEL=

# --- RevenueCat (paywall / subscriptions) ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Backend base URL the client calls for the routes above. In dev this is
# your `expo start` LAN URL; in prod point it at the deployed API. ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081

# --- Supabase (accounts + database). Both values are public: row level
# security on every table limits each user to their own rows. Also read by
# the API routes to verify the caller's session. ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
